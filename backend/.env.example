# Copy this file to .env.local and edit the values for your network.
HOST=0.0.0.0
PORT=8080

# Laptop IPv4 address reachable from the ESP32 and phone on the same LAN.
MQTT_URL=mqtt://192.168.29.88:1883
MQTT_SENSOR_TOPIC=vehicle/001/sensors
MQTT_BUZZER_COMMAND_TOPIC=vehicle/001/command/buzzer

# Prototype trigger only: MQ-3 raw ADC count, not BAC or alcohol concentration.
MQ3_THRESHOLD_RAW=490

# WhatsApp Cloud API. Keep these private; don't commit .env.local.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_META_PERMANENT_ACCESS_TOKEN
WHATSAPP_TO=YOUR_RECIPIENT_NUMBER_WITH_COUNTRY_CODE
WHATSAPP_TEMPLATE_NAME=alcohol_threshold_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Fast2SMS DLT alert. Keep the API key private in backend/.env.local.
# SMS is disabled until you add account credentials/template details and enable it.
FAST2SMS_ENABLED=false
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY
# Indian recipient number, 10 digits without +91.
FAST2SMS_TO=YOUR_10_DIGIT_MOBILE_NUMBER
# q = Fast2SMS Quick/ILDO route (no DLT, but higher per-message cost and provider approval/terms apply).
# dlt = domestic DLT route; requires approved sender header and registered template ID.
FAST2SMS_ROUTE=q
FAST2SMS_DLT_SENDER_ID=YOUR_APPROVED_DLT_HEADER
FAST2SMS_DLT_TEMPLATE_ID=YOUR_APPROVED_DLT_TEMPLATE_ID
# Register a template with two numeric variables in this order: MQ-3 reading, threshold.

# Direct SMS through the SIM800L connected to ESP32 UART GPIO19/18.
# The server sends an MQTT command to the ESP32 only on a threshold crossing.
SIM800L_SMS_ENABLED=false
SIM800L_SMS_COMMAND_TOPIC=vehicle/001/command/sms
SIM800L_SMS_TO=YOUR_RECIPIENT_NUMBER_WITH_COUNTRY_CODE
