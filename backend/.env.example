# Copy this file to .env.local and edit the values for your network.
HOST=0.0.0.0
PORT=8080

# Laptop IPv4 address reachable from the ESP32 and phone on the same LAN.
MQTT_URL=mqtt://192.168.29.88:1883
MQTT_SENSOR_TOPIC=vehicle/001/sensors
MQTT_BUZZER_COMMAND_TOPIC=vehicle/001/command/buzzer

# Prototype trigger only: MQ-3 raw ADC count, not BAC or alcohol concentration.
MQ3_THRESHOLD_RAW=490

# WhatsApp Cloud API. Keep these private; don't commit .env.local.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_META_PERMANENT_ACCESS_TOKEN
WHATSAPP_TO=YOUR_RECIPIENT_NUMBER_WITH_COUNTRY_CODE
WHATSAPP_TEMPLATE_NAME=alcohol_threshold_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
